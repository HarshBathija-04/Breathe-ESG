# Copy to .env for local development (gitignored). Never commit real values.

# ---------- Backend (Render web service) ----------
# False in production
DEBUG=True
# Render: generateValue
SECRET_KEY=change-me
JWT_SECRET=change-me
# Shared Postgres; this app's tables live in schema DB_SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio
DB_SCHEMA=breathe_esg
# CORS allow-list (comma-separated)
FRONTEND_URL=http://localhost:5205
# Optional: enables the AI emissions briefing (Groq)
GROQ_API_KEY=your-groq-api-key
# Optional overrides
# ALLOWED_HOSTS=localhost,127.0.0.1
# MAX_UPLOAD_SIZE_MB=5
# THROTTLE_AUTH=10/min
# THROTTLE_AI=6/min

# ---------- Frontend (Vercel) - see app/.env.example ----------
# VITE_API_URL=http://localhost:5110/api
